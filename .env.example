# Mystic Tarot — copy this file to ".env" and fill in values.
# Sao chép file này thành ".env" rồi điền giá trị.

# ─── Server (Vercel functions / Docker proxy — never bundled to the browser) ─
# Bắt buộc — API key: https://aistudio.google.com/apikey
# KHÔNG dùng tiền tố VITE_ ở đây. Biến này chỉ server đọc được.
GEMINI_API_KEY=

# Tuỳ chọn — model Gemini (mặc định: gemini-2.0-flash).
# Nếu free tier hết quota, thử một trong các giá trị sau rồi chạy lại:
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-1.5-flash

# Tuỳ chọn — giới hạn số yêu cầu/phút/IP (mặc định 20).
# Lưu ý: trên Vercel Edge, bucket là per-instance (reset mỗi cold start).
# Để giới hạn nghiêm ngặt, dùng Vercel KV / Upstash.
# RATE_LIMIT_RPM=20

# ─── Vercel deployment ────────────────────────────────────────────────────────
# Trên Vercel, set các biến trên trong Project → Settings → Environment Variables.
# KHÔNG commit file .env thật. Các biến GEMINI_* (không có VITE_) chỉ server thấy.
# Deploy: git push (auto-deploy) hoặc `vercel --prod`.

# ─── Docker deployment (alternative) ─────────────────────────────────────────
# docker compose up --build  (đọc GEMINI_API_KEY từ .env hoặc shell env)

# ─── Local development ───────────────────────────────────────────────────────
# Chạy cả web + proxy:  npm run dev:all
# Chạy chỉ web:          npm run dev        (cần proxy chạy riêng: npm run dev:proxy)

