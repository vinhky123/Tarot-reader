# Mystic Tarot — copy this file to ".env" and fill in values.
# Sao chép file này thành ".env" rồi điền giá trị.

# ─── Proxy (server-side, never bundled to the browser) ───────────────────────
# Bắt buộc — API key: https://aistudio.google.com/apikey
# KHÔNG dùng tiền tố VITE_ ở đây. Biến này chỉ server (proxy) đọc được.
GEMINI_API_KEY=

# Tuỳ chọn — model Gemini (mặc định trong proxy: gemini-2.0-flash).
# Nếu free tier hết quota, thử một trong các giá trị sau rồi chạy lại proxy:
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-1.5-flash

# Tuỳ chọn — giới hạn số yêu cầu/phút/IP (mặc định 20).
# RATE_LIMIT_RPM=20

# Tuỳ chọn — danh sách origin được phép gọi API, phân tách bằng dấu phẩy.
# Trong docker-compose mặc định là http://localhost:8080.
# ALLOWED_ORIGINS=https://your-domain.example

# ─── Frontend (Vite) — optional, informational only ──────────────────────────
# Giữ lại để tham khảo; proxy mới là nơi chọn model thật.
# VITE_GEMINI_MODEL=gemini-2.0-flash
